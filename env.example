# ─────────────────────────────────────────────────────────────────────────────
# Portal Vacaciones — Variables de entorno
# Copia este fichero como ".env" y rellena los valores reales.
# NUNCA subas el .env real a un repositorio.
# ─────────────────────────────────────────────────────────────────────────────

# ── EMAIL / GMAIL SMTP (OBLIGATORIO) ─────────────────────────────────────────
# Para Gmail necesitas una "Contraseña de aplicación" (App Password):
#   Mi cuenta Google → Seguridad → Verificación en 2 pasos → Contraseñas de apps
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
SMTP_FROM=portal@empresa.com

# ── SMS VÍA TWILIO (OPCIONAL) ────────────────────────────────────────────────
# Crea una cuenta en https://www.twilio.com y obtén:
#   - Account SID  (empieza por AC…)
#   - Auth Token
#   - Número Twilio en formato internacional (+34XXXXXXXXX)
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM=+34600000000

# ── TELEGRAM BOT (OPCIONAL) ──────────────────────────────────────────────────
# 1. Habla con @BotFather en Telegram y crea un bot → obtendrás el TOKEN.
# 2. Cada usuario debe hablar primero con el bot para obtener su Chat ID.
#    Pueden usar @userinfobot para conocerlo.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# ─────────────────────────────────────────────────────────────────────────────
# Cómo cargar el .env en la app (añadir al principio de app.py):
#
#   from dotenv import load_dotenv   # pip install python-dotenv
#   load_dotenv()
# ─────────────────────────────────────────────────────────────────────────────
